# ---------------------------------------------------------------------------
# Sky Concierge environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# SQLite is used for local development (file:./dev.db in prisma/schema.prisma).
# For production, point this at a hosted Postgres (e.g. Neon/Supabase).
DATABASE_URL="file:./dev.db"

# Comma-separated list of CelesTrak NORAD catalog numbers for satellites to
# track. 25544 is the International Space Station.
ISS_NORAD_IDS="25544"
