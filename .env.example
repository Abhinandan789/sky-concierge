[TEMPLATE]
# ---------------------------------------------------------------------------
# Sky Concierge — all configuration is optional.
# The app works with zero env vars (an ephemeral in-memory Postgres + console
# alerts). Set DATABASE_URL to persist subscriptions, RESEND_API_KEY to switch
# to real email, and VAPID_* keys to enable push notifications.
# ---------------------------------------------------------------------------

# Satellites to track (NORAD catalog numbers). 25544 = ISS.
# Comma-separate multiple: "25544,25560"
ISS_NORAD_IDS="25544"

# Postgres connection string (e.g. a free Neon database — one-click Vercel
# integration). Required for persistence in production: Vercel serverless
# filesystems are read-only, so a local SQLite file cannot be used there.
# Leave unset (or ":memory:") in local dev/tests for an ephemeral in-memory
# Postgres that resets on restart.
DATABASE_URL=""

# Public base URL used in confirmation / unsubscribe links. Set this in
# production (e.g. https://sky-concierge.vercel.app).
SITE_URL="http://localhost:3000"

# --- Real email alerts (optional) -------------------------------------------
# Get a key at https://resend.com/api-keys. While unset, alerts print to the
# console so the engine works out of the box.
RESEND_API_KEY=""
# Verified sender — start with "Sky Concierge <onboarding@resend.dev>" to test.
RESEND_FROM="Sky Concierge <onboarding@resend.dev>"
# Signing secret for the delivery/bounce webhook (Resend → Settings →
# Webhooks → your endpoint → signing secret). Point the webhook at
# {SITE_URL}/api/webhooks/resend and subscribe to email.delivered +
# email.bounced. Bounces mark subscriptions as failed and disable them.
# Leave empty in local dev to accept webhook requests without a signature.
RESEND_WEBHOOK_SECRET=""

# --- Scheduled alert checks (optional) --------------------------------------
# Vercel Cron hits /api/cron/alerts every 5 minutes (see vercel.json). Set a
# random secret here and Vercel will send it as `Authorization: Bearer` on
# every cron invocation; the route also accepts it as ?secret= for manual runs.
# Leave empty in local dev to invoke the route without auth.
CRON_SECRET=""

# --- Push notifications (optional) -------------------------------------------
# Generate keys with: pnpm exec web-push generate-vapid-keys
# Until both keys are set, the push toggle stays hidden and the engine
# silently skips push dispatch.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact the push service can reach you at (mailto: or https: URL).
VAPID_SUBJECT="mailto:alerts@localhost"
