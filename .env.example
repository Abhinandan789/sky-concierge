# ---------------------------------------------------------------------------
# Sky Concierge — all configuration is optional.
# The app works with zero env vars (an ephemeral in-memory Postgres + console
# alerts). Set DATABASE_URL to persist subscriptions, GMAIL_USER (or a Brevo /
# Resend key) to switch to real email, and VAPID_* keys to enable push
# notifications.
# ---------------------------------------------------------------------------

# Satellites to track (NORAD catalog numbers). 25544 = ISS.
# Comma-separate multiple: "25544,25560"
ISS_NORAD_IDS="25544"

# Postgres connection string (e.g. a free Neon database — one-click Vercel
# integration). Required for persistence in production: Vercel serverless
# filesystems are read-only, so a local SQLite file cannot be used there.
# Leave unset (or ":memory:") in local dev/tests for an ephemeral in-memory
# Postgres that resets on restart.
DATABASE_URL=""

# Public base URL used in confirmation / unsubscribe links. Set this in
# production (e.g. https://sky-concierge.vercel.app).
SITE_URL="http://localhost:3000"

# --- Real email alerts (optional) -------------------------------------------
# Three providers are supported: Gmail SMTP (recommended — your own Gmail,
# no domain, no provider approval), Brevo (free 300/day, needs a verified
# email address and an ACTIVATED account), and Resend (needs a verified
# domain for anything beyond your own account email). While no key is set,
# alerts print to the console so the engine works out of the box.
#
# GMAIL — sends from your own Gmail to ANY address, works immediately:
#   1. Google Account → Security → turn ON 2-Step Verification.
#   2. Google Account → Security → App passwords → create one for
#      "Sky Concierge" → copy the 16-character password.
#   3. Set GMAIL_USER to your Gmail address and GMAIL_APP_PASSWORD to that
#      app password. Emails arrive from your Gmail address.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
#
# BREVO — free 300 emails/day, no domain required (account must be activated
# by Brevo — new accounts are often gated or suspended; check your inbox for
# the activation email, or contact contact@brevo.com):
#   1. Sign up at https://brevo.com (free, no credit card).
#   2. Settings → Senders, Domains, IPs → Senders → Add a sender → enter any
#      email address you own (e.g. yourname@gmail.com) → click the
#      verification link Brevo emails you.
#   3. Settings → API Keys → Generate a new API key, paste it below, and set
#      BREVO_FROM to the verified address.
BREVO_API_KEY=""
# The exact email address you verified in Brevo (name part optional).
BREVO_FROM="Sky Concierge <yourname@gmail.com>"
#
# RESEND — get a key at https://resend.com/api-keys. NOTE: the free test
# sender (onboarding@resend.dev) can only deliver to YOUR OWN account email;
# sending to other recipients requires a verified domain (resend.com/domains).
RESEND_API_KEY=""
# Verified sender — "Sky Concierge <no-reply@yourdomain.com>" once a domain is
# verified; otherwise "Sky Concierge <onboarding@resend.dev>" (owner-only).
RESEND_FROM="Sky Concierge <onboarding@resend.dev>"
# Signing secret for the delivery/bounce webhook (Resend → Settings →
# Webhooks → your endpoint → signing secret). Point the webhook at
# {SITE_URL}/api/webhooks/resend and subscribe to email.delivered +
# email.bounced. Bounces mark subscriptions as failed and disable them.
# Leave empty in local dev to accept webhook requests without a signature.
RESEND_WEBHOOK_SECRET=""

# --- Scheduled alert checks (optional) --------------------------------------
# Vercel Cron hits /api/cron/alerts every 5 minutes (see vercel.json). Set a
# random secret here and Vercel will send it as `Authorization: Bearer` on
# every cron invocation; the route also accepts it as ?secret= for manual runs.
# Leave empty in local dev to invoke the route without auth.
CRON_SECRET=""

# --- Push notifications (optional) -------------------------------------------
# Generate keys with: pnpm exec web-push generate-vapid-keys
# Until both keys are set, the push toggle stays hidden and the engine
# silently skips push dispatch.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact the push service can reach you at (mailto: or https: URL).
VAPID_SUBJECT="mailto:alerts@localhost"
