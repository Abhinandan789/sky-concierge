// Sky Concierge — Prisma schema
// SQLite for local development. For production, swap the provider to
// postgresql and set the url to your hosted DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Local dev database. See README for the production (Postgres) swap.
  url      = "file:./dev.db"
}

/// A user's alert subscription for one or more sky events at a fixed location.
model AlertSubscription {
  id        String     @id @default(cuid())
  email     String
  lat       Float
  lon       Float
  /// Comma-separated event types: iss,aurora,showers
  events    String     @default("iss,aurora,showers")
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now())
  logs      AlertLog[]

  @@unique([email, lat, lon])
  @@index([email])
}

/// Audit trail of alerts actually dispatched for a subscription.
/// dateKey deduplicates alerts per subscription + event type + UTC day.
model AlertLog {
  id             String            @id @default(cuid())
  subscriptionId String
  eventType      String
  message        String
  dateKey        String
  sentAt         DateTime          @default(now())
  subscription   AlertSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventType, dateKey])
  @@index([subscriptionId, eventType, sentAt])
}
